---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;
---

<section class="py-20 bg-navy-dark">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <svg class="w-12 h-12 mx-auto mb-6 text-brand/40" fill="currentColor" viewBox="0 0 24 24">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
    </svg>
    <blockquote class="text-2xl sm:text-3xl font-light text-gray-300 italic leading-relaxed mb-6">
      "{t.quote.text}"
    </blockquote>
    <p class="text-brand font-semibold text-lg">— {t.quote.author}</p>
  </div>
</section>
