---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;
---

<section id="about" class="py-20 bg-navy">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
      <span class="text-brand">{t.about.heading}</span>
    </h2>
    <p class="text-gray-300 text-lg leading-relaxed">{t.about.text}</p>
  </div>
</section>
