---
import type { TranslationData } from '@/i18n';
interface Props { t: TranslationData; }
const { t } = Astro.props;
---

<section class="py-20 bg-navy-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-16">{t.testimonials.heading}</h2>

    <div class="relative overflow-hidden">
      <div id="testimonials-track" class="flex gap-6 transition-transform duration-500 ease-in-out">
        {t.testimonials.items.map((item) => (
          <div class="flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-navy rounded-xl border border-navy-light/30 p-6">
            <svg class="w-8 h-8 text-brand/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <p class="text-gray-300 text-sm leading-relaxed mb-4 italic">"{item.text}"</p>
            <div class="border-t border-navy-light/30 pt-4">
              <p class="text-brand font-semibold text-sm">{item.author}</p>
              <p class="text-gray-500 text-xs">{item.company}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Navigation buttons -->
    <div class="flex justify-center gap-4 mt-8">
      <button id="testimonials-prev" class="w-10 h-10 rounded-full border border-brand/30 text-brand hover:bg-brand hover:text-white transition-colors flex items-center justify-center" aria-label="Previous">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button id="testimonials-next" class="w-10 h-10 rounded-full border border-brand/30 text-brand hover:bg-brand hover:text-white transition-colors flex items-center justify-center" aria-label="Next">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('testimonials-prev');
  const nextBtn = document.getElementById('testimonials-next');

  if (track && prevBtn && nextBtn) {
    let offset = 0;
    const cards = track.children;
    const gap = 24;

    function getVisibleCount() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function getCardWidth() {
      if (cards.length === 0) return 0;
      return (cards[0] as HTMLElement).offsetWidth + gap;
    }

    function slide(direction: number) {
      const maxOffset = cards.length - getVisibleCount();
      offset = Math.max(0, Math.min(offset + direction, maxOffset));
      track.style.transform = `translateX(-${offset * getCardWidth()}px)`;
    }

    prevBtn.addEventListener('click', () => slide(-1));
    nextBtn.addEventListener('click', () => slide(1));

    window.addEventListener('resize', () => {
      offset = Math.min(offset, cards.length - getVisibleCount());
      track.style.transform = `translateX(-${offset * getCardWidth()}px)`;
    });
  }
</script>
